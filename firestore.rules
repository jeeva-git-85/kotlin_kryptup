rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User collection security:
    // Users can read public profiles (for upiId / recipient lookup).
    // Users can only create or update their own user document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Transactions collection security:
    // Users can only access their own transaction records.
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
